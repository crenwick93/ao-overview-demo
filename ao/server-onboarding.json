{
  "schema_version": "2.0.0",
  "name": "Server Onboarding",
  "description": "End-to-end server onboarding: EDA trigger from ServiceNow service request, environment routing with approval gate, parallel Day 1 registrations, validation, and Git audit trail. Each step updates work notes on the RITM automatically.",
  "triggers": [
    {
      "id": "trigger_snow",
      "type": "eda_trigger",
      "name": "ServiceNow Request",
      "parameters": {
        "input_schema": {
          "type": "object",
          "properties": {
            "server_name": {
              "type": "string",
              "description": "Requested hostname"
            },
            "os_type": {
              "type": "string",
              "description": "Operating system (e.g. RHEL 9)"
            },
            "environment": {
              "type": "string",
              "description": "Target environment: dev, staging, or prod"
            },
            "application": {
              "type": "string",
              "description": "Application to install (e.g. PostgreSQL)"
            },
            "ritm_number": {
              "type": "string",
              "description": "ServiceNow RITM number"
            },
            "ritm_sys_id": {
              "type": "string",
              "description": "ServiceNow RITM sys_id"
            }
          }
        }
      },
      "position": { "x": 400, "y": 0 }
    }
  ],
  "nodes": [
    {
      "id": "env_switch",
      "type": "switch",
      "name": "Route by Environment",
      "parameters": {
        "cases": [
          {
            "port": "case_dev",
            "label": "Development",
            "condition": "${trigger_snow.environment} == 'dev'"
          },
          {
            "port": "case_staging",
            "label": "Staging",
            "condition": "${trigger_snow.environment} == 'staging'"
          },
          {
            "port": "case_prod",
            "label": "Production",
            "condition": "${trigger_snow.environment} == 'prod'"
          }
        ]
      },
      "position": { "x": 400, "y": 100 }
    },
    {
      "id": "prod_approval",
      "type": "approval",
      "name": "CAB Approval",
      "parameters": {
        "description": "Production server onboarding requires CAB approval before provisioning.",
        "timeout": 0
      },
      "position": { "x": 700, "y": 200 }
    },
    {
      "id": "provision",
      "type": "aap_job_template",
      "name": "Provision Server",
      "parameters": {
        "job_template_name": "Provision Server",
        "organization_name": "Default",
        "extra_vars": {
          "server_name": "${trigger_snow.server_name}",
          "os_type": "${trigger_snow.os_type}",
          "environment": "${trigger_snow.environment}",
          "ritm_sys_id": "${trigger_snow.ritm_sys_id}"
        }
      },
      "position": { "x": 400, "y": 300 }
    },
    {
      "id": "server_ready_loop",
      "type": "loop",
      "name": "Retry Until Ready",
      "parameters": {
        "loop_type": "while",
        "max_iterations": 10,
        "condition": "${check_server_ready.artifacts.server_ready} != true"
      },
      "position": { "x": 400, "y": 370 }
    },
    {
      "id": "wait_between_checks",
      "type": "wait",
      "name": "Wait 30s",
      "parameters": {
        "duration": 30
      },
      "position": { "x": 400, "y": 430 }
    },
    {
      "id": "check_server_ready",
      "type": "aap_job_template",
      "name": "Check Server Ready",
      "parameters": {
        "job_template_name": "Check Server Ready",
        "organization_name": "Default",
        "extra_vars": {
          "server_name": "${trigger_snow.server_name}",
          "server_ip": "${provision.artifacts.server_ip}"
        }
      },
      "position": { "x": 400, "y": 490 }
    },
    {
      "id": "register_dns",
      "type": "aap_job_template",
      "name": "Register DNS",
      "parameters": {
        "job_template_name": "Register Service",
        "organization_name": "Default",
        "extra_vars": {
          "service_name": "dns",
          "server_name": "${trigger_snow.server_name}",
          "server_ip": "${provision.artifacts.server_ip}",
          "ritm_sys_id": "${trigger_snow.ritm_sys_id}"
        }
      },
      "position": { "x": 100, "y": 500 }
    },
    {
      "id": "register_monitoring",
      "type": "aap_job_template",
      "name": "Register Monitoring",
      "parameters": {
        "job_template_name": "Register Service",
        "organization_name": "Default",
        "extra_vars": {
          "service_name": "monitoring",
          "server_name": "${trigger_snow.server_name}",
          "server_ip": "${provision.artifacts.server_ip}",
          "ritm_sys_id": "${trigger_snow.ritm_sys_id}"
        }
      },
      "position": { "x": 300, "y": 500 }
    },
    {
      "id": "register_cmdb",
      "type": "aap_job_template",
      "name": "Register CMDB",
      "parameters": {
        "job_template_name": "Register Service",
        "organization_name": "Default",
        "extra_vars": {
          "service_name": "cmdb",
          "server_name": "${trigger_snow.server_name}",
          "server_ip": "${provision.artifacts.server_ip}",
          "ritm_sys_id": "${trigger_snow.ritm_sys_id}"
        }
      },
      "position": { "x": 500, "y": 500 }
    },
    {
      "id": "register_backup",
      "type": "aap_job_template",
      "name": "Register Backup",
      "parameters": {
        "job_template_name": "Register Service",
        "organization_name": "Default",
        "extra_vars": {
          "service_name": "backup",
          "server_name": "${trigger_snow.server_name}",
          "server_ip": "${provision.artifacts.server_ip}",
          "ritm_sys_id": "${trigger_snow.ritm_sys_id}"
        }
      },
      "position": { "x": 700, "y": 500 }
    },
    {
      "id": "validate",
      "type": "aap_job_template",
      "name": "Validate Server",
      "parameters": {
        "job_template_name": "Validate Server",
        "organization_name": "Default",
        "extra_vars": {
          "server_name": "${trigger_snow.server_name}",
          "server_ip": "${provision.artifacts.server_ip}",
          "ritm_sys_id": "${trigger_snow.ritm_sys_id}"
        }
      },
      "position": { "x": 400, "y": 600 }
    },
    {
      "id": "close_request",
      "type": "aap_job_template",
      "name": "Close Request",
      "parameters": {
        "job_template_name": "Manage SNOW Request",
        "organization_name": "Default",
        "extra_vars": {
          "action": "close",
          "ritm_sys_id": "${trigger_snow.ritm_sys_id}",
          "work_notes": "<h3>Server Onboarding Complete</h3><p>Server ${trigger_snow.server_name} with ${trigger_snow.application} fully onboarded and Day 1 ready. All services registered and validated.</p>"
        }
      },
      "position": { "x": 250, "y": 600 }
    }
  ],
  "edges": [
    { "from": "trigger_snow", "to": "env_switch" },
    { "from": "env_switch", "to": "provision", "from_port": "case_dev" },
    { "from": "env_switch", "to": "provision", "from_port": "case_staging" },
    { "from": "env_switch", "to": "prod_approval", "from_port": "case_prod" },
    { "from": "prod_approval", "to": "provision", "from_port": "approved" },
    { "from": "provision", "to": "server_ready_loop" },
    { "from": "server_ready_loop", "to": "wait_between_checks" },
    { "from": "wait_between_checks", "to": "check_server_ready" },
    { "from": "check_server_ready", "to": "server_ready_loop" },
    { "from": "server_ready_loop", "to": "register_dns", "from_port": "complete" },
    { "from": "server_ready_loop", "to": "register_monitoring", "from_port": "complete" },
    { "from": "server_ready_loop", "to": "register_cmdb", "from_port": "complete" },
    { "from": "server_ready_loop", "to": "register_backup", "from_port": "complete" },
    { "from": "register_dns", "to": "validate" },
    { "from": "register_monitoring", "to": "validate" },
    { "from": "register_cmdb", "to": "validate" },
    { "from": "register_backup", "to": "validate" },
    { "from": "validate", "to": "close_request" }
  ]
}
