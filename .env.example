# Copy this file to ".env" at the repo root and adjust values as needed.
# IMPORTANT: Do not commit real secrets. Keep tokens/passwords out of version control.

############################################
# AAP (ansible_deployment)
############################################
AAP_HOSTNAME=https://your-aap-instance.example.com/
AAP_TOKEN=your-aap-oauth-token
AAP_VALIDATE_CERTS=false
AAP_ORG=Default

############################################
# ServiceNow
############################################
SERVICENOW_INSTANCE_URL=https://devXXXXXX.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your-snow-password

############################################
# GitHub (for committing audit reports from AO workflows)
############################################
GITHUB_REPO=crenwick93/ao-overview-demo
GITHUB_TOKEN=your-github-pat

############################################
# AO Webhook (filled after publishing the workflow with an EDA trigger)
############################################
AO_WEBHOOK_BASE_URL=https://your-aap-instance.example.com
AO_WEBHOOK_PATH=your-workflow-trigger
AO_WEBHOOK_CLIENT_ID=your-ao-client-id
AO_WEBHOOK_CLIENT_SECRET=your-ao-client-secret

############################################
# AO API Service Account (for approval bridge)
############################################
# Create a service account in AO with project-admin role.
AO_SA_CLIENT_ID=your-ao-sa-client-id
AO_SA_CLIENT_SECRET=your-ao-sa-client-secret

############################################
# EDA Decision Environment
############################################
# Custom DE image with servicenow.itsm for EDA polling.
# Build from dependencies/de/decision-environment.yml
DE_IMAGE=YOUR_REGISTRY/snow-de:latest
